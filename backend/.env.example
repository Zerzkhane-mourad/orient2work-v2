# ──────────────────────────────────────────────────────────────────────────────
# Orient2Work API — variables d'environnement
# Copier en `.env` puis remplir. AUCUN secret ne doit être commité.
# Toutes ces variables sont validées par zod au démarrage (src/config/env.ts) :
# le serveur refuse de démarrer si l'une est manquante ou invalide.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Préfixe de toutes les routes de l'API
API_PREFIX=/api/v1
# URL publique du frontend (liens dans les emails de vérification / reset)
APP_URL=http://localhost:3000

# ── Base de données PostgreSQL ────────────────────────────────────────────────
DATABASE_URL="postgresql://orient2work:changeme@localhost:5432/orient2work?schema=public"
# Base dédiée aux tests d'intégration (jamais la même que le dev)
TEST_DATABASE_URL="postgresql://orient2work:changeme@localhost:5432/orient2work_test?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 48   (2 secrets DIFFÉRENTS, min. 32 caractères)
JWT_ACCESS_SECRET=remplacer_par_un_secret_aleatoire_de_32_caracteres_minimum
JWT_REFRESH_SECRET=remplacer_par_un_autre_secret_aleatoire_de_32_caracteres
# Durée de vie de l'access token (courte volontairement)
JWT_ACCESS_TTL=15m
# Durée de vie du refresh token (cookie httpOnly, rotation à chaque usage)
JWT_REFRESH_TTL=7d
JWT_ISSUER=orient2work-api
JWT_AUDIENCE=orient2work-web

# ── Cookies / CSRF ────────────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
# `true` en production (HTTPS obligatoire pour le flag Secure)
COOKIE_SECURE=false
# Secret de signature du cookie de session/CSRF
COOKIE_SECRET=remplacer_par_un_secret_aleatoire_de_32_caracteres_minimum

# ── CORS ──────────────────────────────────────────────────────────────────────
# Whitelist stricte, séparée par des virgules. JAMAIS `*` (credentials activés).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ── Sécurité mots de passe ────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Uploads (CV, logo, photo) ─────────────────────────────────────────────────
# Répertoire HORS du dossier servi statiquement : les fichiers ne sont jamais
# exécutables ni accessibles directement par URL, ils transitent par un contrôleur.
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_SIZE_BYTES=5242880

# ── Emails (vérification d'inscription, reset de mot de passe) ────────────────
# Laisser SMTP_HOST vide en développement : les emails sont alors écrits dans les logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Orient2Work <no-reply@orient2work.ma>"
EMAIL_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=15

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Compte administrateur créé par le seed ────────────────────────────────────
SEED_ADMIN_EMAIL=admin@orient2work.ma
SEED_ADMIN_PASSWORD=Admin!2026Change

# ── Rappels d'entretien ───────────────────────────────────────────────────────
# Fuseau dans lequel sont exprimees les heures d'entretien (`heure` = heure
# murale). Sans lui, impossible de savoir a quel instant reel « 14:00 » renvoie.
APP_TIMEZONE=Africa/Casablanca
# Periode de balayage du planificateur, en minutes. Sert aussi de tolerance :
# un entretien dont l'echeance tombe entre deux passages est quand meme rappele.
RAPPEL_INTERVALLE_MIN=5
